{
  "version": 8,
  "name": "MD Editorial Dark",
  "metadata": {
    "description": "Custom dark map for The Millionaire's Dollar. Water #0a0a0a, land #1a1a1a, hairline country borders, country labels only at higher zooms. No cities, no roads."
  },
  "sources": {
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "sprite": "mapbox://sprites/mapbox/dark-v11",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "projection": { "name": "mercator" },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1a1a1a" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#0a0a0a" }
    },
    {
      "id": "admin-0-boundary",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 0],
        ["==", ["get", "disputed"], "false"],
        ["==", ["get", "maritime"], "false"]
      ],
      "paint": {
        "line-color": "#2a2a2a",
        "line-width": 0.5
      }
    },
    {
      "id": "country-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "minzoom": 3,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["get", "name_en"],
        "text-font": ["DIN Pro Regular", "Arial Unicode MS Regular"],
        "text-size": 10,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#6b6862",
        "text-halo-color": "#0a0a0a",
        "text-halo-width": 1
      }
    }
  ]
}
